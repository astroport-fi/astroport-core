{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ExecuteMsg",
  "oneOf": [
    {
      "description": "Swaps the given fee tokens into the base asset along their routes, then splits the base asset across the legs. Anyone can call it, unless `collectors` is set.",
      "type": "object",
      "required": [
        "collect"
      ],
      "properties": {
        "collect": {
          "type": "object",
          "required": [
            "assets"
          ],
          "properties": {
            "assets": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/CollectAsset"
              }
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    {
      "description": "Internal: splits the base asset, or `limit` of it, across the legs.",
      "type": "object",
      "required": [
        "distribute"
      ],
      "properties": {
        "distribute": {
          "type": "object",
          "properties": {
            "limit": {
              "anyOf": [
                {
                  "$ref": "#/definitions/Uint128"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    {
      "description": "Internal: records the Maker's balance of a leg's output asset before its swap.",
      "type": "object",
      "required": [
        "snapshot_leg"
      ],
      "properties": {
        "snapshot_leg": {
          "type": "object",
          "required": [
            "leg"
          ],
          "properties": {
            "leg": {
              "type": "integer",
              "format": "uint32",
              "minimum": 0.0
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    {
      "description": "Internal: deposits what a leg's swap produced.",
      "type": "object",
      "required": [
        "deposit_leg"
      ],
      "properties": {
        "deposit_leg": {
          "type": "object",
          "required": [
            "leg"
          ],
          "properties": {
            "leg": {
              "type": "integer",
              "format": "uint32",
              "minimum": 0.0
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    {
      "description": "Owner only. Leaves unset fields as they are.",
      "type": "object",
      "required": [
        "update_config"
      ],
      "properties": {
        "update_config": {
          "type": "object",
          "properties": {
            "base_asset": {
              "anyOf": [
                {
                  "$ref": "#/definitions/AssetInfo"
                },
                {
                  "type": "null"
                }
              ]
            },
            "collect_cooldown": {
              "description": "`0` removes the cooldown",
              "type": [
                "integer",
                "null"
              ],
              "format": "uint64",
              "minimum": 0.0
            },
            "collectors": {
              "description": "An empty list lets anyone call collect again",
              "type": [
                "array",
                "null"
              ],
              "items": {
                "type": "string"
              }
            },
            "legs": {
              "type": [
                "array",
                "null"
              ],
              "items": {
                "$ref": "#/definitions/Leg"
              }
            },
            "max_spread": {
              "anyOf": [
                {
                  "$ref": "#/definitions/Decimal"
                },
                {
                  "type": "null"
                }
              ]
            },
            "router": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    {
      "description": "Owner only. Sets or removes fee token routes to the base asset.",
      "type": "object",
      "required": [
        "update_routes"
      ],
      "properties": {
        "update_routes": {
          "type": "object",
          "properties": {
            "add": {
              "default": [],
              "type": "array",
              "items": {
                "type": "array",
                "items": [
                  {
                    "$ref": "#/definitions/AssetInfo"
                  },
                  {
                    "type": "array",
                    "items": {
                      "$ref": "#/definitions/SwapOperation"
                    }
                  }
                ],
                "maxItems": 2,
                "minItems": 2
              }
            },
            "remove": {
              "default": [],
              "type": "array",
              "items": {
                "$ref": "#/definitions/AssetInfo"
              }
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    {
      "description": "Creates a request to change contract ownership. Owner only.",
      "type": "object",
      "required": [
        "propose_new_owner"
      ],
      "properties": {
        "propose_new_owner": {
          "type": "object",
          "required": [
            "expires_in",
            "owner"
          ],
          "properties": {
            "expires_in": {
              "type": "integer",
              "format": "uint64",
              "minimum": 0.0
            },
            "owner": {
              "type": "string"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    {
      "description": "Removes a request to change contract ownership. Owner only.",
      "type": "object",
      "required": [
        "drop_ownership_proposal"
      ],
      "properties": {
        "drop_ownership_proposal": {
          "type": "object",
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    {
      "description": "Claims contract ownership. Only the proposed owner.",
      "type": "object",
      "required": [
        "claim_ownership"
      ],
      "properties": {
        "claim_ownership": {
          "type": "object",
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    {
      "description": "Permissionless: sends the given seizable assets to the seize receiver.",
      "type": "object",
      "required": [
        "seize"
      ],
      "properties": {
        "seize": {
          "type": "object",
          "required": [
            "assets"
          ],
          "properties": {
            "assets": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/AssetWithLimit"
              }
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    {
      "description": "Owner only. Leaves unset fields as they are.",
      "type": "object",
      "required": [
        "update_seize_config"
      ],
      "properties": {
        "update_seize_config": {
          "type": "object",
          "properties": {
            "receiver": {
              "type": [
                "string",
                "null"
              ]
            },
            "seizable_assets": {
              "description": "Replaces the seizable assets as a whole. An empty list clears them",
              "type": [
                "array",
                "null"
              ],
              "items": {
                "$ref": "#/definitions/AssetInfo"
              }
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  ],
  "definitions": {
    "Addr": {
      "description": "A human readable address.\n\nIn Cosmos, this is typically bech32 encoded. But for multi-chain smart contracts no assumptions should be made other than being UTF-8 encoded and of reasonable length.\n\nThis type represents a validated address. It can be created in the following ways 1. Use `Addr::unchecked(input)` 2. Use `let checked: Addr = deps.api.addr_validate(input)?` 3. Use `let checked: Addr = deps.api.addr_humanize(canonical_addr)?` 4. Deserialize from JSON. This must only be done from JSON that was validated before such as a contract's state. `Addr` must not be used in messages sent by the user because this would result in unvalidated instances.\n\nThis type is immutable. If you really need to mutate it (Really? Are you sure?), create a mutable copy using `let mut mutable = Addr::to_string()` and operate on that `String` instance.",
      "type": "string"
    },
    "AssetInfo": {
      "description": "This enum describes available Token types. ## Examples ``` # use cosmwasm_std::Addr; # use astroport::asset::AssetInfo::{NativeToken, Token}; Token { contract_addr: Addr::unchecked(\"stake...\") }; NativeToken { denom: String::from(\"uluna\") }; ```",
      "oneOf": [
        {
          "description": "Non-native Token",
          "type": "object",
          "required": [
            "token"
          ],
          "properties": {
            "token": {
              "type": "object",
              "required": [
                "contract_addr"
              ],
              "properties": {
                "contract_addr": {
                  "$ref": "#/definitions/Addr"
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        {
          "description": "Native token",
          "type": "object",
          "required": [
            "native_token"
          ],
          "properties": {
            "native_token": {
              "type": "object",
              "required": [
                "denom"
              ],
              "properties": {
                "denom": {
                  "type": "string"
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "AssetWithLimit": {
      "description": "An asset to seize, and optionally the most of it to send in this call.",
      "type": "object",
      "required": [
        "info"
      ],
      "properties": {
        "info": {
          "$ref": "#/definitions/AssetInfo"
        },
        "limit": {
          "anyOf": [
            {
              "$ref": "#/definitions/Uint128"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "Binary": {
      "description": "Binary is a wrapper around Vec<u8> to add base64 de/serialization with serde. It also adds some helper methods to help encode inline.\n\nThis is only needed as serde-json-{core,wasm} has a horrible encoding for Vec<u8>. See also <https://github.com/CosmWasm/cosmwasm/blob/main/docs/MESSAGE_TYPES.md>.",
      "type": "string"
    },
    "CollectAsset": {
      "description": "A fee token to collect.",
      "type": "object",
      "required": [
        "info"
      ],
      "properties": {
        "info": {
          "$ref": "#/definitions/AssetInfo"
        },
        "limit": {
          "description": "The most of it to swap in this call. For the base asset, the most of it to split across the legs.",
          "anyOf": [
            {
              "$ref": "#/definitions/Uint128"
            },
            {
              "type": "null"
            }
          ]
        },
        "min_receive": {
          "description": "The least base asset its swap must return, e.g. from a quote taken elsewhere first. The swap fails below it even where the Maker's own price check, which only sees the pool as it is, would let it through. Ignored for the base asset and for amounts too small to price.",
          "anyOf": [
            {
              "$ref": "#/definitions/Uint128"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "Decimal": {
      "description": "A fixed-point decimal value with 18 fractional digits, i.e. Decimal(1_000_000_000_000_000_000) == 1.0\n\nThe greatest possible value that can be represented is 340282366920938463463.374607431768211455 (which is (2^128 - 1) / 10^18)",
      "type": "string"
    },
    "Leg": {
      "description": "One destination for part of the collected fees.",
      "type": "object",
      "required": [
        "action",
        "share"
      ],
      "properties": {
        "action": {
          "$ref": "#/definitions/LegAction"
        },
        "route": {
          "description": "Swap operations from the base asset into the leg's output asset, through the router. Empty to keep the base asset. A route doesn't visit the same asset twice.",
          "default": [],
          "type": "array",
          "items": {
            "$ref": "#/definitions/SwapOperation"
          }
        },
        "share": {
          "description": "Share of the base asset this leg gets. All legs' shares add up to exactly 1.",
          "allOf": [
            {
              "$ref": "#/definitions/Decimal"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "LegAction": {
      "description": "What a leg does with its share once it's in the leg's output asset. The target can't be the Maker itself.",
      "oneOf": [
        {
          "description": "Send the share to an address.",
          "type": "object",
          "required": [
            "send"
          ],
          "properties": {
            "send": {
              "type": "object",
              "required": [
                "recipient"
              ],
              "properties": {
                "recipient": {
                  "type": "string"
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        {
          "description": "Execute `contract` with `msg` and the share attached (native funds, or a CW20 `send` with `msg` as its hook), so the receiver knows it has been paid, e.g. a burner or a staking contract that distributes rewards.",
          "type": "object",
          "required": [
            "deposit"
          ],
          "properties": {
            "deposit": {
              "type": "object",
              "required": [
                "contract",
                "msg"
              ],
              "properties": {
                "contract": {
                  "type": "string"
                },
                "msg": {
                  "$ref": "#/definitions/Binary"
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "SwapOperation": {
      "description": "This enum describes a swap operation.",
      "oneOf": [
        {
          "description": "Swap in the factory's pool for this asset pair",
          "type": "object",
          "required": [
            "astro_swap"
          ],
          "properties": {
            "astro_swap": {
              "type": "object",
              "required": [
                "ask_asset_info",
                "offer_asset_info"
              ],
              "properties": {
                "ask_asset_info": {
                  "description": "Information about the asset we swap to",
                  "allOf": [
                    {
                      "$ref": "#/definitions/AssetInfo"
                    }
                  ]
                },
                "offer_asset_info": {
                  "description": "Information about the asset being swapped",
                  "allOf": [
                    {
                      "$ref": "#/definitions/AssetInfo"
                    }
                  ]
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        {
          "description": "Swap in a specific pool, given by address. Unlike [`SwapOperation::AstroSwap`] the pool doesn't have to be registered in the factory, so standalone pools (e.g. a transmuter instantiated directly) can be part of a multi-hop route. The pool must report both assets in its `pair {}` query.",
          "type": "object",
          "required": [
            "pool_swap"
          ],
          "properties": {
            "pool_swap": {
              "type": "object",
              "required": [
                "ask_asset_info",
                "offer_asset_info",
                "pool_addr"
              ],
              "properties": {
                "ask_asset_info": {
                  "description": "Information about the asset we swap to",
                  "allOf": [
                    {
                      "$ref": "#/definitions/AssetInfo"
                    }
                  ]
                },
                "offer_asset_info": {
                  "description": "Information about the asset being swapped",
                  "allOf": [
                    {
                      "$ref": "#/definitions/AssetInfo"
                    }
                  ]
                },
                "pool_addr": {
                  "description": "The pool contract address",
                  "type": "string"
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "Uint128": {
      "description": "A thin wrapper around u128 that is using strings for JSON encoding/decoding, such that the full u128 range can be used for clients that convert JSON numbers to floats, like JavaScript and jq.\n\n# Examples\n\nUse `from` to create instances of this and `u128` to get the value out:\n\n``` # use cosmwasm_std::Uint128; let a = Uint128::from(123u128); assert_eq!(a.u128(), 123);\n\nlet b = Uint128::from(42u64); assert_eq!(b.u128(), 42);\n\nlet c = Uint128::from(70u32); assert_eq!(c.u128(), 70); ```",
      "type": "string"
    }
  }
}
