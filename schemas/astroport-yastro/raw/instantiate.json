{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "InstantiateMsg",
  "type": "object",
  "required": [
    "astro_denom",
    "decimals",
    "name",
    "owner",
    "reward_denoms",
    "symbol",
    "unbonding_period"
  ],
  "properties": {
    "astro_denom": {
      "description": "The denom staked for yASTRO, 1:1",
      "type": "string"
    },
    "decimals": {
      "type": "integer",
      "format": "uint8",
      "minimum": 0.0
    },
    "incentives": {
      "description": "Astroport Incentives, for forwarding registered pools' rewards to their LP stakers",
      "type": [
        "string",
        "null"
      ]
    },
    "name": {
      "type": "string"
    },
    "owner": {
      "type": "string"
    },
    "reward_denoms": {
      "description": "Denoms `deposit_rewards` accepts",
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "symbol": {
      "type": "string"
    },
    "unbonding_period": {
      "description": "Seconds between unstaking and being able to withdraw",
      "type": "integer",
      "format": "uint64",
      "minimum": 0.0
    }
  },
  "additionalProperties": false
}
